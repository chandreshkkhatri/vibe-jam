{
  "name": "simple-blogging-platform-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:smoke": "jest tests/smoke.test.js --runInBand",
    "test:api": "jest tests/api.test.js --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage --runInBand"
  },
  "keywords": [
    "blog",
    "api",
    "express",
    "sqlite",
    "jwt",
    "rest"
  ],
  "author": "Your Name",
  "license": "ISC",
  "description": "A RESTful API backend for a simple blogging platform with user authentication, blog management, likes, and comments",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.js",
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ]
  }
}